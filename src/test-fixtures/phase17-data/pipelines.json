  "pipelineVersions": [
    {
      "id": "ws_wovi:idea-to-post@1.0.0",
      "workspaceId": "ws_wovi",
      "pipelineId": "idea-to-post",
      "version": "1.0.0",
      "body": {
        "id": "idea-to-post",
        "version": "1.0.0",
        "name": "Idea to ready post",
        "job": "Takes one idea to a hook, a script, a caption and tags for a short video, in your voice, ready for your yes.",
        "inputs": [
          {
            "key": "start",
            "label": "Where to start",
            "required": true,
            "help": "With ideas first, Idea Generator gives you seven and you pick one.",
            "type": "choice",
            "options": [
              {
                "value": "my_idea",
                "label": "I have an idea"
              },
              {
                "value": "ideas",
                "label": "Give me ideas first"
              }
            ],
            "multiple": false,
            "default": "my_idea"
          },
          {
            "key": "platform",
            "label": "Platform",
            "required": true,
            "help": "Where the video goes.",
            "type": "choice",
            "options": [
              {
                "value": "tiktok",
                "label": "TikTok"
              },
              {
                "value": "shorts",
                "label": "YouTube Shorts"
              },
              {
                "value": "reels",
                "label": "Instagram Reels"
              }
            ],
            "multiple": false,
            "default": "tiktok"
          },
          {
            "key": "idea",
            "label": "Your idea",
            "required": true,
            "help": "One or two sentences with the real details: names, numbers, what happens. With ideas first, say what to post about.",
            "type": "long_text",
            "limits": {
              "minLength": 10,
              "maxLength": 300
            }
          },
          {
            "key": "length",
            "label": "Length",
            "required": true,
            "type": "choice",
            "options": [
              {
                "value": "s15",
                "label": "15 seconds"
              },
              {
                "value": "s30",
                "label": "30 seconds"
              },
              {
                "value": "s60",
                "label": "60 seconds"
              }
            ],
            "multiple": false,
            "default": "s30"
          },
          {
            "key": "details",
            "label": "Facts to include",
            "required": false,
            "help": "Anything the caption must get exactly right, like a date, a price or a name.",
            "type": "text",
            "limits": {
              "maxLength": 300
            }
          },
          {
            "key": "footage",
            "label": "What you can film",
            "required": false,
            "help": "Places, things and people you can actually film, like: the counter, the oven, my hands.",
            "type": "long_text",
            "limits": {
              "maxLength": 400
            }
          },
          {
            "key": "brand",
            "label": "Brand Brain",
            "required": false,
            "help": "Which brand or client this is for. Uses your default Brand Brain when left empty.",
            "type": "profile"
          }
        ],
        "brand": {
          "input": "brand"
        },
        "steps": [
          {
            "id": "ideas",
            "label": "Find the idea",
            "agent": {
              "id": "idea-generator",
              "version": "current"
            },
            "inputs": {
              "topic": {
                "from": "input",
                "key": "idea"
              },
              "platform": {
                "from": "input",
                "key": "platform"
              }
            },
            "choose": {
              "kind": "ask",
              "label": "Pick the idea to make"
            },
            "onFail": {
              "when": "brand",
              "rewrite": true,
              "then": "review"
            },
            "runIf": {
              "input": "start",
              "equals": "ideas"
            }
          },
          {
            "id": "hooks",
            "label": "Write the hooks",
            "agent": {
              "id": "hook-writer",
              "version": "current"
            },
            "inputs": {
              "idea": {
                "from": "template",
                "text": "{{steps.ideas.picked.idea|inputs.idea}}"
              },
              "platform": {
                "from": "input",
                "key": "platform"
              }
            },
            "choose": {
              "kind": "ask",
              "label": "Pick the hook you like best"
            },
            "onFail": {
              "when": "brand",
              "rewrite": true,
              "then": "review"
            }
          },
          {
            "id": "script",
            "label": "Write the script",
            "agent": {
              "id": "script-writer",
              "version": "current"
            },
            "inputs": {
              "idea": {
                "from": "template",
                "text": "Open with this hook: {{steps.hooks.picked}}\n\nThe idea: {{steps.ideas.picked.idea|inputs.idea}}"
              },
              "length": {
                "from": "input",
                "key": "length"
              },
              "footage": {
                "from": "input",
                "key": "footage"
              }
            },
            "onFail": {
              "when": "brand",
              "rewrite": true,
              "then": "review"
            }
          },
          {
            "id": "caption",
            "label": "Write the caption",
            "agent": {
              "id": "caption-writer",
              "version": "current"
            },
            "inputs": {
              "post": {
                "from": "step",
                "step": "script",
                "take": "all"
              },
              "platforms": {
                "from": "input",
                "key": "platform"
              },
              "details": {
                "from": "input",
                "key": "details"
              }
            },
            "choose": {
              "kind": "best_brand_fit"
            },
            "onFail": {
              "when": "brand",
              "rewrite": true,
              "then": "review"
            }
          },
          {
            "id": "tags",
            "label": "Pick the tags",
            "agent": {
              "id": "hashtag-picker",
              "version": "current"
            },
            "inputs": {
              "caption": {
                "from": "step",
                "step": "caption",
                "take": "picked"
              },
              "platform": {
                "from": "input",
                "key": "platform"
              }
            }
          }
        ],
        "package": [
          {
            "step": "ideas",
            "label": "Idea",
            "take": "picked"
          },
          {
            "step": "hooks",
            "label": "Hook",
            "take": "picked"
          },
          {
            "step": "script",
            "label": "Script",
            "take": "all"
          },
          {
            "step": "caption",
            "label": "Caption",
            "take": "picked"
          },
          {
            "step": "tags",
            "label": "Tags and search words",
            "take": "all"
          }
        ],
        "approve": {
          "label": "Happy with it? Approve it and it is ready to post."
        },
        "maxCostUsd": 1
      },
      "note": "Pipeline template",
      "by": "usr_wovi_launch",
      "createdAt": "2026-10-23T07:50:39.195Z"
    },
