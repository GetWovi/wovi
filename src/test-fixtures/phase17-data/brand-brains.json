        "niche": "Invoicing app for UK freelancers",
        "platforms": [
          "x",
          "tiktok",
          "shorts"
        ],
        "voice": {
          "description": "Clear, friendly and a bit nerdy about money admin. Explains one thing at a time with a worked number. Never salesy, never scary about tax. Talks to freelancers as peers.",
