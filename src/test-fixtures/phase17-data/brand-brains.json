        "niche": "Beginner strength gym in Manchester",
        "platforms": [
          "tiktok",
          "shorts",
          "reels"
        ],
        "voice": {
          "description": "Encouraging but blunt. Plain gym talk, no bro-speak. Short sentences. Celebrates small, real numbers: a first pull-up, a first 40 kg deadlift. Sounds like a coach between sets, not an influencer.",
