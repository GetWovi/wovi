            "toxins"
          ],
          "samples": [
            "Margaret is 61. Today she deadlifted 60 kg.",
            "You do not need to be fit to start. That is our job.",
            "Strong is a skill. You practise it."
          ]
        },
        "topics": [
          "first lifts",
          "members over 40",
          "form before weight"
        ],
        "references": [
          {
            "id": "ref_09227a45e0468d0822c0",
            "text": "Margaret is 61. Six months ago she needed a hand to get up off the floor. Today she deadlifted 60 kg. No secret. Two sessions a week and a coach who made her slow down.",
