            "leverage",
            "empower",
            "revolutionary",
            "all-in-one"
          ],
          "samples": [
            "Your invoice is not late. Their payment is.",
            "Invoice 0047 got paid in 2 days. Here is what was different.",
            "Tax is not scary. Not knowing the date is."
          ]
        },
        "topics": [
          "late payments",
          "invoice wording",
          "Self Assessment dates"
        ],
        "references": [
          {
            "id": "ref_0996719b3b8e5e3d04c6",
            "text": "Swap 'Payment terms: 30 days' for 'Due 14 March'. A date is harder to ignore than a rule.",
